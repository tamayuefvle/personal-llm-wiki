{
  "name": "personal-llm-wiki",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Read-only recall CLI for a local-first Markdown knowledge vault",
  "bin": {
    "wiki": "dist/src/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test --test-isolation=none dist/tests/*.test.js",
    "wiki": "npm run build --silent && node dist/src/cli.js"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "typescript": "^7.0.2"
  }
}
